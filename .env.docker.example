# Copy this file to .env.docker and replace every CHANGE_ME value.
# Never commit .env.docker or real secrets.

POSTGRES_USER=sionna
POSTGRES_PASSWORD=sionna-local-password
POSTGRES_DB=sionna_simulation
POSTGRES_HOST_PORT=5433

AUTH_SECRET_KEY=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_SECRET

ELASTICSEARCH_INDEX=sionna-logs-dev
ELASTICSEARCH_LOG_RETENTION_DAYS=7

# Background simulation worker reliability settings.
SIMULATION_WORKER_POLL_SECONDS=1
SIMULATION_JOB_HEARTBEAT_SECONDS=20
SIMULATION_JOB_LEASE_SECONDS=90
SIMULATION_JOB_TIMEOUT_SECONDS=3600
SIMULATION_JOB_MAX_ATTEMPTS=3
SIMULATION_JOB_RETRY_BASE_SECONDS=5
SIMULATION_JOB_RETRY_MAX_SECONDS=300
